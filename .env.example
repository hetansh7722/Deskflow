GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional alert channels (leave blank to disable)
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=1

# Auth (leave AUTH_SECRET blank to auto-generate a local secret file)
AUTH_SECRET=
DESKFLOW_DEMO_PASSWORD=Deskflow@123

# Background monitors (minutes)
SLA_SCAN_INTERVAL_MINUTES=1
STALE_AFTER_DAYS=7
